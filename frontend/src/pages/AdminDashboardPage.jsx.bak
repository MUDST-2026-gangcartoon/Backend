
import React, { useEffect, useMemo, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import AdminNavbar from '../components/AdminNavbar.jsx';
import { eventService } from '../api/eventService.js';
import '../admin-dashboard.css';

const CIRCLE_RADIUS = 50;
const CIRCLE_CIRCUMFERENCE = 2 * Math.PI * CIRCLE_RADIUS;

function toNumber(value) {
  if (value === null || value === undefined || value === '') return null;
  const number = Number(value);
  return Number.isFinite(number) ? number : null;
}

function extractEvents(response) {
  if (Array.isArray(response)) return response;
  if (Array.isArray(response?.content)) return response.content;
  if (Array.isArray(response?.items)) return response.items;
  if (Array.isArray(response?.data)) return response.data;
  if (Array.isArray(response?.data?.content)) return response.data.content;
  if (Array.isArray(response?.data?.items)) return response.data.items;
  return null;
}

function extractAnalytics(response) {
  if (response && typeof response === 'object' && !Array.isArray(response)) {
    if ('totalRegistrations' in response) return response;
    if (response.data && typeof response.data === 'object') {
      if ('totalRegistrations' in response.data) return response.data;
    }
  }
  return null;
}

function formatNumber(value) {
  return new Intl.NumberFormat('th-TH').format(value);
}

export default function AdminDashboardPage() {
  const navigate = useNavigate();

  const [events, setEvents] = useState([]);
  const [analytics, setAnalytics] = useState(null);
  const [eventsState, setEventsState] = useState('loading');
  const [analyticsState, setAnalyticsState] = useState('loading');
  const [retryCount, setRetryCount] = useState(0);

  useEffect(() => {
    let cancelled = false;

    async function loadEvents() {
      setEventsState('loading');

      try {
        const response = await eventService.getAllEvents();
        const result = extractEvents(response);

        if (!result) {
          throw new Error('รูปแบบข้อมูลรายการอีเวนต์ไม่ถูกต้อง');
        }

        if (!cancelled) {
          setEvents(result);
          setEventsState('success');
        }
      } catch (error) {
        console.error('Failed to load dashboard events:', error);
        if (!cancelled) setEventsState('error');
      }
    }

    async function loadAnalytics() {
      setAnalyticsState('loading');

      try {
        const response = await eventService.getAdminStats();
        const result = extractAnalytics(response);

        if (!result) {
          throw new Error('รูปแบบข้อมูล Analytics ไม่ถูกต้อง');
        }

        if (!cancelled) {
          setAnalytics(result);
          setAnalyticsState('success');
        }
      } catch (error) {
        console.error('Failed to load dashboard analytics:', error);

        if (!cancelled) {
          setAnalytics(null);
          setAnalyticsState('error');
        }
      }
    }

    loadEvents();
    loadAnalytics();

    return () => {
      cancelled = true;
    };
  }, [retryCount]);

  const capacityStats = useMemo(() => {
    const eventsWithCapacity = events.filter((event) => {
      const capacity = toNumber(event.capacity);
      const spotsLeft = toNumber(event.spotsLeft);

      return (
        capacity !== null &&
        capacity >= 0 &&
        spotsLeft !== null &&
        spotsLeft >= 0
      );
    });

    const totalCapacity = eventsWithCapacity.reduce(
      (total, event) => total + toNumber(event.capacity),
      0,
    );

    const bookedSeats = eventsWithCapacity.reduce((total, event) => {
      const capacity = toNumber(event.capacity);
      const spotsLeft = toNumber(event.spotsLeft);

      return total + Math.max(0, Math.min(capacity, capacity - spotsLeft));
    }, 0);

    return {
      totalCapacity,
      bookedSeats,
      hasCapacityData: eventsWithCapacity.length > 0,
      utilization:
        totalCapacity > 0
          ? Math.round((bookedSeats / totalCapacity) * 100)
          : null,
    };
  }, [events]);

  const isEventsLoading = eventsState === 'loading';
  const isAnalyticsLoading = analyticsState === 'loading';
  const hasEventsError = eventsState === 'error';
  const hasAnalyticsError = analyticsState === 'error';

  const siteViews = toNumber(analytics?.siteViews);
  const eventDetailViews = toNumber(analytics?.eventDetailViews);

  const maxViews = Math.max(siteViews ?? 0, eventDetailViews ?? 0, 1);

  const donutOffset =
    capacityStats.utilization === null
      ? CIRCLE_CIRCUMFERENCE
      : CIRCLE_CIRCUMFERENCE * (1 - capacityStats.utilization / 100);

  return (
    <>
      <AdminNavbar />

      <main className="dashboard-page">
        <section className="dashboard-header">
          <div className="dashboard-header-left">
            <div className="dashboard-eyebrow">ภาพรวมผู้จัดงาน</div>
            <h1>ภาพรวมที่ช่วยให้งานของคุณเดินต่อ</h1>
            <p className="dashboard-subtitle">
              ดูข้อมูลอีเวนต์ การลงทะเบียน และการเข้าชมจากระบบ
            </p>
          </div>

          <button
            type="button"
            className="dashboard-event-btn"
            onClick={() => navigate('/manage-events')}
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 20h9"
                stroke="currentColor"
                strokeWidth="2"
                strokeLinecap="round"
              />
              <path
                d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                stroke="currentColor"
                strokeWidth="2"
                strokeLinecap="round"
                strokeLinejoin="round"
              />
            </svg>
            จัดการอีเวนต์
          </button>
        </section>

        <div className="dashboard-divider" />

        {(hasEventsError || hasAnalyticsError) && (
          <div
            role="alert"
            style={{
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              gap: 16,
              padding: '14px 16px',
              marginBottom: 20,
              border: '1px solid #FECACA',
              borderRadius: 12,
              background: '#FEF2F2',
              color: '#991B1B',
            }}
          >
            <span>
              โหลดข้อมูลบางส่วนไม่สำเร็จ กรุณาตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง
            </span>
            <button
              type="button"
              onClick={() => setRetryCount((count) => count + 1)}
            >
              ลองอีกครั้ง
            </button>
          </div>
        )}

        {eventsState === 'success' && events.length === 0 && (
          <div
            role="status"
            style={{
              padding: '14px 16px',
              marginBottom: 20,
              border: '1px solid #BAE6FD',
              borderRadius: 12,
              background: '#F0F9FF',
              color: '#075985',
            }}
          >
            ยังไม่มีอีเวนต์ที่ API ส่งกลับมา
          </div>
        )}

        <section
          className="dashboard-stats"
          aria-busy={isAnalyticsLoading}
        >
          <article className="dashboard-stat-card dashboard-stat-highlight">
            <div className="dashboard-stat-label">ยอดลงทะเบียนรวม</div>
            <div className="dashboard-stat-number">
              {isAnalyticsLoading
                ? '…'
                : hasAnalyticsError || analytics?.totalRegistrations == null
                  ? '—'
                  : formatNumber(analytics.totalRegistrations)}
            </div>
            <div className="dashboard-stat-description">
              จำนวนการลงทะเบียนทั้งหมดจาก Backend
            </div>
          </article>

          <article className="dashboard-stat-card">
            <div className="dashboard-stat-label">อีเวนต์ที่เปิดรับ</div>
            <div className="dashboard-stat-number">
              {isAnalyticsLoading
                ? '…'
                : hasAnalyticsError || analytics?.totalOpenEvents == null
                  ? '—'
                  : formatNumber(analytics.totalOpenEvents)}
            </div>
            <div className="dashboard-stat-description">
              จำนวนอีเวนต์ที่มีสถานะเปิดรับ
            </div>
          </article>

          <article className="dashboard-stat-card">
            <div className="dashboard-stat-label">ผู้เข้าชมไม่ซ้ำ</div>
            <div className="dashboard-stat-number">
              {isAnalyticsLoading
                ? '…'
                : hasAnalyticsError || analytics?.uniqueVisitors == null
                  ? '—'
                  : formatNumber(analytics.uniqueVisitors)}
            </div>
            <div className="dashboard-stat-description">
              จำนวนผู้เข้าชมไม่ซ้ำตามข้อมูล Analytics
            </div>
          </article>
        </section>

        <section className="dashboard-charts">
          <article className="dashboard-chart-card dashboard-bar-card">
            <div className="dashboard-chart-header">
              <div>
                <div className="dashboard-chart-label">การเข้าชม</div>
                <h2>ยอดเข้าชมเว็บไซต์และหน้าอีเวนต์</h2>
              </div>
              <div className="dashboard-chart-tag">ข้อมูล Analytics</div>
            </div>

            <div
              className="dashboard-bar-chart"
              role="status"
              aria-busy={isAnalyticsLoading}
              style={{
                minHeight: 190,
                display: 'flex',
                flexDirection: 'column',
                justifyContent: 'center',
                gap: 24,
                padding: 20,
              }}
            >
              {isAnalyticsLoading ? (
                <p>กำลังโหลดข้อมูล…</p>
              ) : hasAnalyticsError ? (
                <p>ไม่สามารถโหลดข้อมูล Analytics ได้</p>
              ) : (
                <>
                  <div>
                    <div
                      style={{
                        display: 'flex',
                        justifyContent: 'space-between',
                        gap: 12,
                        marginBottom: 8,
                      }}
                    >
                      <span>เข้าชมเว็บไซต์</span>
                      <strong>
                        {siteViews === null ? '—' : formatNumber(siteViews)}
                      </strong>
                    </div>
                    <div
                      style={{
                        height: 12,
                        background: '#E0F2FE',
                        borderRadius: 999,
                        overflow: 'hidden',
                      }}
                    >
                      <div
                        style={{
                          height: '100%',
                          width: `${((siteViews ?? 0) / maxViews) * 100}%`,
                          background: '#38BDF8',
                          borderRadius: 999,
                        }}
                      />
                    </div>
                  </div>

                  <div>
                    <div
                      style={{
                        display: 'flex',
                        justifyContent: 'space-between',
                        gap: 12,
                        marginBottom: 8,
                      }}
                    >
                      <span>เข้าชมหน้าอีเวนต์</span>
                      <strong>
                        {eventDetailViews === null
                          ? '—'
                          : formatNumber(eventDetailViews)}
                      </strong>
                    </div>
                    <div
                      style={{
                        height: 12,
                        background: '#FCE7DF',
                        borderRadius: 999,
                        overflow: 'hidden',
                      }}
                    >
                      <div
                        style={{
                          height: '100%',
                          width: `${((eventDetailViews ?? 0) / maxViews) * 100}%`,
                          background: '#FF6B4A',
                          borderRadius: 999,
                        }}
                      />
                    </div>
                  </div>
                </>
              )}
            </div>
          </article>

          <article className="dashboard-chart-card dashboard-donut-card">
            <div className="dashboard-chart-header">
              <div>
                <div className="dashboard-chart-label">การใช้ความจุ</div>
                <h2>ที่นั่งในอีเวนต์</h2>
              </div>
              <div className="dashboard-chart-tag">จาก Event API</div>
            </div>

            <div className="dashboard-donut-content" aria-busy={isEventsLoading}>
              <div className="dashboard-donut">
                <svg
                  width="130"
                  height="130"
                  viewBox="0 0 130 130"
                  aria-hidden="true"
                >
                  <circle
                    cx="65"
                    cy="65"
                    r={CIRCLE_RADIUS}
                    fill="none"
                    stroke="#BAE6FD"
                    strokeWidth="14"
                  />
                  {capacityStats.hasCapacityData &&
                    !isEventsLoading &&
                    !hasEventsError && (
                      <circle
                        cx="65"
                        cy="65"
                        r={CIRCLE_RADIUS}
                        fill="none"
                        stroke="#FF6B4A"
                        strokeWidth="14"
                        strokeDasharray={`${CIRCLE_CIRCUMFERENCE - donutOffset} ${CIRCLE_CIRCUMFERENCE}`}
                        strokeLinecap="round"
                        transform="rotate(-90 65 65)"
                      />
                    )}
                </svg>

                <div className="dashboard-donut-center">
                  {isEventsLoading
                    ? '…'
                    : hasEventsError || capacityStats.utilization === null
                      ? '—'
                      : `${capacityStats.utilization}%`}
                </div>
              </div>

              <div className="dashboard-donut-info">
                <div className="dashboard-seat-number">
                  {isEventsLoading
                    ? '…'
                    : hasEventsError || !capacityStats.hasCapacityData
                      ? '—'
                      : (
                        <>
                          {formatNumber(capacityStats.bookedSeats)}
                          <span> / {formatNumber(capacityStats.totalCapacity)}</span>
                        </>
                      )}
                </div>
                <p>
                  {capacityStats.hasCapacityData
                    ? 'จำนวนที่นั่งที่ถูกจองเทียบกับความจุของอีเวนต์ที่มีข้อมูลครบ'
                    : 'ยังไม่มีข้อมูลความจุและที่นั่งว่างเพียงพอสำหรับคำนวณ'}
                </p>
              </div>
            </div>

            <div className="dashboard-legend">
              <div className="dashboard-legend-item">
                <span className="dashboard-legend-dot dashboard-booked" />
                <span>จองแล้ว</span>
              </div>
              <div className="dashboard-legend-item">
                <span className="dashboard-legend-dot dashboard-open" />
                <span>ที่ว่าง</span>
              </div>
            </div>
          </article>
        </section>
      </main>
    </>
  );
}
